{
  "name": "syrian-martyrs-memorial",
  "version": "1.0.0",
  "description": "Syrian Martyrs Memorial - A platform to honor and remember Syrian martyrs",
  "private": true,
  "workspaces": [
    "web",
    "api",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "cd web && npm run dev",
    "dev:api": "cd api && npm run dev",
    "build": "npm run build:api && npm run build:web",
    "build:web": "cd web && npm run build",
    "build:api": "cd api && npm run build",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:web": "cd web && npm run start",
    "start:api": "cd api && npm run start",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose --profile production up --build",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v --rmi all",
    "docker:logs": "docker-compose logs -f",
    "db:generate": "cd api && npm run db:generate",
    "db:push": "cd api && npm run db:push",
    "db:migrate": "cd api && npm run db:migrate",
    "db:seed": "cd api && npm run db:seed",
    "db:studio": "cd api && npm run db:studio",
    "install:all": "npm install && cd web && npm install && cd ../api && npm install",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "cd web && npm run lint",
    "lint:api": "cd api && npm run lint",
    "test": "npm run test:api",
    "test:api": "cd api && npm run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}