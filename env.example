# ===========================================
# Environment Variables (Development)
# ===========================================
# Copy this file to .env and update with your credentials
# NEVER commit .env to git!

# Database Configuration
# For development with Prisma Accelerate:
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_API_KEY_HERE"

# For local PostgreSQL (alternative):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/syrian_martyrs_db"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-key-change-this"

# Next.js Authentication
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Email Verification
# Set to "false" for development (skip email verification)
# Set to "true" for production (require email verification)
REQUIRE_EMAIL_VERIFICATION="false"

# ===========================================
# Optional: Email Service (for production)
# ===========================================
# EMAIL_HOST="smtp.example.com"
# EMAIL_PORT="587"
# EMAIL_USER="noreply@example.com"
# EMAIL_PASSWORD="your-email-password"
# EMAIL_FROM="noreply@example.com"

# ===========================================
# Optional: Database Connection Pooling
# ===========================================
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=20

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Generate strong secrets: openssl rand -base64 32
# 2. Use different secrets for dev/prod
# 3. Never commit .env files to git
# 4. For production, copy env.production.example to .env.production
