# Development Dockerfile for API Service
FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package.json ./
COPY prisma ./prisma/
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Generate Prisma client
RUN npx prisma generate

EXPOSE 3001

ENV PORT 3001

CMD ["npm", "run", "dev"]

